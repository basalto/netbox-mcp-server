# Copy to .env and fill in real values. Never commit .env.
# NetBox base URL (scheme://host:port, no trailing slash). LE cert via Traefik.
NETBOX_URL=https://netbox.apps.stdout.pt
# NetBox API token — V2 bearer, form nbt_<key>.<plaintext>. Mint one in the NetBox pod:
#   Token.objects.create(user=u, version=TokenVersionChoices.V2)
NETBOX_TOKEN=CHANGE_ME
# Optional: bearer token for the MCP endpoint itself. Empty = unauthenticated.
MCP_AUTH_TOKEN=
# Verify the NetBox TLS cert (LE-signed; leave true).
NETBOX_VERIFY_SSL=true
NETBOX_REQUEST_TIMEOUT=15
NETBOX_LOG_LEVEL=INFO
